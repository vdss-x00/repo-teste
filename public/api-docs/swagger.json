{
  "openapi": "3.0.3",
  "info": {
    "title": "Restaurant Ordering System - API",
    "version": "1.0.0",
    "description": "API REST para gerenciamento de categorias e produtos de um sistema de pedidos de restaurante."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor atual (local ou Vercel)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "Categories",
      "description": "Gerenciamento de categorias"
    },
    {
      "name": "Products",
      "description": "Gerenciamento de produtos"
    }
  ],
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readonly": true
          },
          "name": {
            "type": "string",
            "example": "Pizzas"
          },
          "description": {
            "type": "string",
            "example": "Pizzas tradicionais e especiais"
          },
          "icon": {
            "type": "string",
            "example": "🍕"
          },
          "display_order": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "CreateCategory": {
        "type": "object",
        "required": [
          "name",
          "display_order"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Pizzas"
          },
          "display_order": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "description": {
            "type": "string",
            "example": "Pizzas tradicionais e especiais"
          },
          "icon": {
            "type": "string",
            "example": ""
          }
        }
      },
      "UpdateCategory": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Pizzas"
          },
          "display_order": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "description": {
            "type": "string",
            "example": "Pizzas tradicionais e especiais"
          },
          "icon": {
            "type": "string",
            "example": ""
          },
          "active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readonly": true
          },
          "category_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "example": "Pizza Margherita"
          },
          "description": {
            "type": "string",
            "example": "Pizza com tomate e queijo"
          },
          "price": {
            "type": "number",
            "format": "float",
            "example": 65
          },
          "image": {
            "type": "string",
            "nullable": true,
            "example": ""
          },
          "available": {
            "type": "boolean",
            "example": true
          },
          "active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "CreateProduct": {
        "type": "object",
        "required": [
          "category_id",
          "title",
          "price"
        ],
        "properties": {
          "category_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "example": "Pizza Margherita"
          },
          "description": {
            "type": "string",
            "example": "Pizza com tomate e queijo"
          },
          "price": {
            "type": "number",
            "format": "float",
            "example": 65
          },
          "image": {
            "type": "string",
            "example": ""
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Erro ao processar solicitação."
          }
        }
      }
    }
  },
  "paths": {
    "/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Listar todos os produtos",
        "responses": {
          "200": {
            "description": "Lista de produtos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Criar um produto",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProduct"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produto criado"
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Buscar produto por ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produto encontrado"
          },
          "404": {
            "description": "Produto não encontrado"
          }
        }
      },
      "put": {
        "tags": [
          "Products"
        ],
        "summary": "Atualizar um produto",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProduct"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Produto atualizado"
          }
        }
      },
      "delete": {
        "tags": [
          "Products"
        ],
        "summary": "Remover um produto",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produto removido"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "Listar todas as categorias",
        "description": "Retorna todas as categorias cadastradas.",
        "responses": {
          "200": {
            "description": "Lista de categorias retornadas com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ao buscar categorias.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Categories"
        ],
        "summary": "Criar uma categoria",
        "description": "Cadastra uma nova categoria.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCategory"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Categoria criada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos."
          },
          "500": {
            "description": "Erro interno ao criar categoria."
          }
        }
      }
    },
    "/categories/search": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "Buscar categorias por palavra-chave",
        "description": "Retorna categorias com base em uma palavra-chave.",
        "parameters": [
          {
            "in": "query",
            "name": "keyword",
            "required": true,
            "description": "Palavra-chave utilizada na pesquisa",
            "schema": {
              "type": "string",
              "example": "pizza"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Categorias encontradas com sucesso."
          },
          "500": {
            "description": "Erro interno ao buscar categorias."
          }
        }
      }
    },
    "/categories/{id}": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "Buscar categoria por ID",
        "description": "Retorna uma categoria específica pelo seu identificador.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID da categoria."
          }
        ],
        "responses": {
          "200": {
            "description": "Categoria encontrada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "404": {
            "description": "Categoria não encontrada."
          },
          "500": {
            "description": "Erro interno ao buscar categoria."
          }
        }
      },
      "put": {
        "tags": [
          "Categories"
        ],
        "summary": "Atualizar uma categoria",
        "description": "Atualiza os dados de uma categoria existente.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID da categoria."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCategory"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Categoria atualizada com sucesso."
          },
          "400": {
            "description": "Dados inválidos."
          },
          "404": {
            "description": "Categoria não encontrada."
          },
          "500": {
            "description": "Erro interno ao atualizar categoria."
          }
        }
      },
      "delete": {
        "tags": [
          "Categories"
        ],
        "summary": "Remover uma categoria",
        "description": "Remove uma categoria pelo seu identificador.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID da categoria."
          }
        ],
        "responses": {
          "200": {
            "description": "Categoria removida com sucesso."
          },
          "404": {
            "description": "Categoria não encontrada."
          },
          "500": {
            "description": "Erro interno ao remover categoria."
          }
        }
      }
    }
  }
}